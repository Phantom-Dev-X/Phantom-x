# Copy this file to .env and fill in your values
# (Only needed on non-Replit platforms like Render, Railway, VPS, or local machine)
# Replit users: use the Secrets tab instead

# Required — get from @BotFather on Telegram
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Required for Telegram backup restore/upload
# Put the private Telegram channel ID here after adding the bot as admin
# Example: -1001234567890
BACKUP_CHANNEL_ID=your_private_channel_id_here

# Optional — set this to your Telegram numeric ID so backup failures can DM you exact reasons
OWNER_ID=your_telegram_user_id_here

# Optional — get from https://aistudio.google.com/ for AI commands (.ai / .gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional — port for the keep-alive server (default: 3000)
# PORT=3000

# Optional — set to true to print detailed runtime logs for group commands, reconnects, and restore flow
# DEBUG_RUNTIME=true

# Optional — set to true to trace every group message path (web listener, handleMessage, drops, parsed cmd type)
# GROUP_TRACE=true

# Optional — set to true to send button-focused debug traces to your WhatsApp self chat
# BUTTON_TRACE=true

# Optional — force a fixed 8-char pairing code (A-Z, 0-9) for everyone.
# Default is 12345678. Set to "random" to let WhatsApp generate a random code.
# NOTE: a fixed/predictable code can look bot-like to WhatsApp anti-abuse and is
# more likely to be rate-limited than a random one. Use "random" if you hit issues.
# CUSTOM_PAIR_CODE=12345678
